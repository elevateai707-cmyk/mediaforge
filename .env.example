# Local-only MediaForge. No runtime paid LLM requirement.
MF_HOST=127.0.0.1
MF_PORT=8420
MF_AI_ENABLED=1
MF_OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HOST=http://127.0.0.1:11434
MF_WHISPER_MODEL=small.en
MF_WHISPER_COMPUTE=int8
# Comma-separated local folders. Never uploaded automatically.
MEDIA_DIRS=
MF_MUSIC_DIR=
# Optional: may instead be saved through local Settings (server-side, mode 0600).
COMFY_API_KEY=
ELEVENLABS_API_KEY=
# Do not set COMFY_BASE_URL: this adapter targets Comfy Cloud only.
