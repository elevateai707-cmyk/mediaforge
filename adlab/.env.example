# Copy to adlab/.env and fill in. Never commit .env.

# Claude API: teardown vision (Phase 3) + briefs (Phase 4). Or use `ant auth login`.
ANTHROPIC_API_KEY=
ADLAB_MODEL=claude-opus-5-5

# Local Hermes LLM (OpenAI-compatible endpoint), optional cheaper drafts
HERMES_BASE_URL=                 # your local server's OpenAI-compatible /v1 URL

# Supabase (service-role key: server-side only; RLS blocks the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Media Forge + Elevate Vision Studio
MEDIAFORGE_URL=http://127.0.0.1:8420
STUDIO_CLI=                      # blank = find evstudio-cli on PATH / ~/.local/bin

# Meta Ad Library API (optional; only returns commercial ads that reached the EU,
# see docs/data_sources.md). Turn on per site in sites/<site>/scout.yaml.
META_AD_LIBRARY_TOKEN=

# Claude: server-side fallbacks (beta) are ON so a capacity error retries on another model;
# set to 0 to pin every call to ADLAB_MODEL.
ADLAB_LLM_FALLBACKS=1

# Producer (Phase 5). ComfyUI: your URL + workflows in config/comfyui/ (see its README).
COMFYUI_URL=                     # e.g. http://127.0.0.1:8188
ADLAB_COMFY_MIN_FREE_MB=0        # refuse a ComfyUI job below this much free VRAM
ADLAB_X264_PRESET=medium
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=             # stock voice or your own clone (or brand.yaml voice_id per site)
ELEVENLABS_MODEL=eleven_multilingual_v2

# Reporter (Phase 7): your own Meta ad account, read-only (ads_read). Or import CSVs.
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=              # digits, without act_

# Weekly digest (Resend)
RESEND_API_KEY=
DIGEST_FROM=                     # e.g. AdLab <adlab@yourdomain.ca> (domain verified in Resend)
DIGEST_TO=                       # comma-separated

# Dashboard API (`adlab serve`). Required before binding beyond localhost.
ADLAB_API_TOKEN=

# Optional overrides
ADLAB_DATA_DIR=                  # default adlab/data (git-ignored)
