# Copy to adlab/.env and fill in. Never commit .env.

# Claude API: teardown vision (Phase 3) + briefs (Phase 4). Or use `ant auth login`.
ANTHROPIC_API_KEY=
ADLAB_MODEL=claude-opus-5-5

# Local Hermes LLM (OpenAI-compatible endpoint), optional cheaper drafts
HERMES_BASE_URL=                 # your local server's OpenAI-compatible /v1 URL

# Supabase (service-role key: server-side only; RLS blocks the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Media Forge + Elevate Vision Studio
MEDIAFORGE_URL=http://127.0.0.1:8420
STUDIO_CLI=                      # blank = find evstudio-cli on PATH / ~/.local/bin

# ComfyUI: pending your answer (see docs/mediaforge_interface.md)
COMFYUI_URL=

# Phase 5 / 7
ELEVENLABS_API_KEY=
RESEND_API_KEY=

# Optional overrides
ADLAB_DATA_DIR=                  # default adlab/data (git-ignored)
